{
    "name": "nextjs-mongo-template",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "NODE_OPTIONS='--max-old-space-size=512' next dev --hostname 0.0.0.0 --port 3000",
        "dev:no-reload": "next dev --hostname 0.0.0.0 --port 3000",
        "dev:webpack": "next dev --hostname 0.0.0.0 --port 3000",
        "build": "next build",
        "test": "vitest run",
        "start": "next start",
        "postinstall": "prisma generate",
        "prisma:generate": "prisma generate",
        "prisma:migrate:dev": "prisma migrate dev",
        "prisma:migrate:deploy": "echo '[BLOCKED] npm run prisma:migrate:deploy no longer calls Prisma directly. Use npm run db:migrate:preview or npm run db:migrate:production (see scripts/run-migration-safe.sh).' 1>&2 && exit 1",
        "prisma:push": "prisma db push",
        "db:migrate:deploy": "echo '[BLOCKED] npm run db:migrate:deploy no longer calls Prisma directly. Use npm run db:migrate:preview or npm run db:migrate:production (see scripts/run-migration-safe.sh).' 1>&2 && exit 1",
        "db:migrate:preflight": "node scripts/db-migration-preflight.cjs",
        "db:migrate:preview": "bash scripts/run-migration-safe.sh --env preview",
        "db:migrate:production": "bash scripts/run-migration-safe.sh --env production",
        "db:health": "node scripts/check-db-connection.js",
        "migrate:local-to-prisma:dry-run": "node scripts/migrate-local-json-to-prisma.js",
        "migrate:local-to-prisma": "node scripts/migrate-local-json-to-prisma.js --execute"
    },
