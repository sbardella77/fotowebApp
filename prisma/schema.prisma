generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PhotoStatus {
  VISIBLE
  HIDDEN
}

enum BlobUploadKind {
  ROOM_PHOTO
  PRIVATE_DELIVERY
  PHOTOGRAPHER_UPLOAD
}

enum BlobUploadSessionStatus {
  PENDING
  TOKEN_ISSUED
  UPLOADED
  COMPLETED
  REJECTED
  CLEANUP_PENDING
  CLEANUP_FAILED
  EXPIRED_CLEANED
}

enum StripeWebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Owner {
  id                                 String                    @id @default(uuid())
  email                              String                    @unique
  passwordHash                       String?
  passwordSalt                       String?
  plan                               String                    @default("free")
  extraEventCredits                  Int                       @default(0)
  extraEventCheckoutSessionId        String?
  stripeCustomerId                   String?
  stripeSubscriptionId               String?
  stripeCheckoutSessionId            String?
  sessionVersion                     Int                       @default(0)
  passwordChangedAt                  DateTime?
  planUpdatedAt                      DateTime                  @default(now())
  subscriptionCanceledAt             DateTime?
  subscriptionCancelAtPeriodEnd      Boolean                   @default(false)
  subscriptionCurrentPeriodEnd       DateTime?
  subscriptionCancelScheduledAt      DateTime?
  subscriptionBillingInterval        String?
  subscriptionStatus                 String?
  paymentFailedAt                    DateTime?
  subscriptionGraceUntil             DateTime?
  lastInvoiceId                      String?
  lastInvoiceStatus                  String?
  lastPaymentError                   String?
  stripeBillingCursorSubscriptionId  String?
  lastStripeSubscriptionEventCreated BigInt?
  lastStripeInvoiceEventCreated      BigInt?
  createdAt                          DateTime                  @default(now())
  updatedAt                          DateTime                  @updatedAt
  events                             Event[]
  extraFreeEventCheckouts            ExtraFreeEventCheckout[]
  passwordResetTokens                OwnerPasswordResetToken[]

  @@index([email])
}

model OwnerPasswordResetToken {
  id              String    @id @default(cuid())
  ownerId         String
  owner           Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  purpose         String    @default("password_reset")
  expiresAt       DateTime
  usedAt          DateTime?
  requestedIpHash String?
  createdAt       DateTime  @default(now())

  @@index([ownerId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Event {
  id                                String               @id @default(uuid())
  slug                              String               @unique
  name                              String
  ownerEmail                        String?
  ownerId                           String?
  owner                             Owner?               @relation(fields: [ownerId], references: [id])
  managementTokenHash               String?
  coverPhotoId                      String?
  billingTier                       String?
  stripeCheckoutSessionId           String?
  billingPurchasedAt                DateTime?
  originalDownloadUnlocked          Boolean              @default(false)
  originalDownloadCheckoutSessionId String?
  photographerUploadTokenHash       String?
  photographerUploadTokenExpiresAt  DateTime?
  retentionUntil                    DateTime?
  vaultExtendedUntil                DateTime?
  retentionPolicy                   String?
  archiveLocked                     Boolean              @default(false)
  gracePeriodUntil                  DateTime?
  coverUrl                          String?
  createdAt                         DateTime             @default(now())
  updatedAt                         DateTime             @updatedAt
  photos                            Photo[]
  privateAssets                     PrivateAsset[]
  galleryDownloadJobs               GalleryDownloadJob[]
  moments                           EventMoment[]
  blobUploadSessions                BlobUploadSession[]

  @@index([createdAt])
  @@index([ownerId])
  @@index([billingTier])
  @@index([photographerUploadTokenHash])
}

model EventMoment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos    Photo[]

  @@unique([eventId, slug])
  @@index([eventId, sortOrder])
}

model Photo {
  id              String       @id @default(uuid())
  eventId         String
  originalName    String
  storedName      String
  mimeType        String
  size            Int
  url             String
  uploaderName    String?
  caption         String?
  status          PhotoStatus  @default(VISIBLE)
  uploadSource    String       @default("mobile")
  width           Int?
  height          Int?
  momentId        String?
  contributorId   String?
  // Server-derived only — never trust a client-supplied value. 'owner' when
  // the request carried a valid owner session matching this photo's event
  // owner at upload time, 'guest' otherwise. NULL on rows created before
  // this field existed: unknown, never treated as 'guest'. Analytics
  // attribution only — never used for authorization/entitlements.
  uploadActorType String?
  moment          EventMoment? @relation(fields: [momentId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([momentId, createdAt(sort: Desc)])
}

model PrivateAsset {
  id             String   @id @default(uuid())
  eventId        String
  originalName   String
  storedName     String
  mimeType       String
  size           Int
  url            String
  uploadedByRole String?  @default("owner")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc)])
}

model AdminCredential {
  id           String   @id @default(uuid())
  key          String   @unique @default("primary")
  passwordSalt String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

model DeletionLog {
  id        String   @id @default(uuid())
  photoId   String
  eventSlug String
  deletedBy String
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventSlug])
}

model GalleryDownloadJob {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status        String    @default("PENDING")
  resultUrl     String?
  error         String?
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  processedAt   DateTime?

  @@index([eventId, status])
  @@index([createdAt])
  @@index([status, processedAt])
  @@index([status, updatedAt])
}

model ExtraFreeEventCheckout {
  id                      String    @id @default(cuid())
  ownerId                 String
  owner                   Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String?   @unique
  eventName               String?
  status                  String    @default("pending")
  createdEventId          String?
  createdEventSlug        String?
  errorMessage            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  completedAt             DateTime?
  autoCreatedAt           DateTime?

  @@index([ownerId, status])
  @@index([stripeCheckoutSessionId])
}

model UpsellEvent {
  id         String   @id @default(uuid())
  eventName  String
  upsellType String?
  source     String?
  location   String?
  ctaPlan    String?
  ownerId    String?
  eventId    String?
  eventSlug  String?
  createdAt  DateTime @default(now())

  @@index([eventName, upsellType])
  @@index([source])
  @@index([createdAt])
}

model BlobUploadSession {
  id String @id @default(cuid())

  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventSlug String

  uploadKind BlobUploadKind
  status     BlobUploadSessionStatus @default(PENDING)

  expectedPathname String @unique
  originalName     String
  mimeType         String
  expectedSize     Int

  uploaderName    String?
  caption         String?
  momentId        String?
  contributorId   String?
  // Server-bound at init time, for ROOM_PHOTO sessions only — never for
  // PRIVATE_DELIVERY/PHOTOGRAPHER_UPLOAD (those use PrivateAsset.uploadedByRole
  // instead). Carried through to Photo.uploadActorType at completion; never
  // read from the completion request payload. See lib/server/gallery-upload-actor.js.
  uploadActorType String?

  blobUrl  String?
  resultId String?

  tokenIssuedAt DateTime?
  uploadedAt    DateTime?
  consumedAt    DateTime?
  expiresAt     DateTime

  cleanupAttempts Int     @default(0)
  lastError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([eventSlug])
  @@index([status, expiresAt])
  @@index([uploadKind, status])
}

model StripeWebhookEvent {
  id        String                   @id @default(cuid())
  eventId   String                   @unique
  eventType String
  status    StripeWebhookEventStatus @default(PENDING)

  attempts  Int     @default(0)
  lastError String?

  receivedAt          DateTime  @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?

  updatedAt DateTime @updatedAt

  @@index([status, processingStartedAt])
}
