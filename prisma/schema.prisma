generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PhotoStatus {
  VISIBLE
  HIDDEN
}

model Owner {
  id                     String   @id @default(uuid())
  email                  String   @unique
  passwordHash           String?
  passwordSalt           String?
  plan                   String   @default("free")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  stripeCheckoutSessionId String?
  planUpdatedAt          DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  events                 Event[]

  @@index([email])
}

model Event {
  id                     String   @id @default(uuid())
  slug                   String   @unique
  name                   String
  ownerEmail             String?
  ownerId                String?
  owner                  Owner?   @relation(fields: [ownerId], references: [id])
  managementTokenHash    String?
  coverPhotoId           String?
  billingTier            String?
  stripeCheckoutSessionId String?
  billingPurchasedAt     DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  photos                 Photo[]

  @@index([createdAt])
  @@index([ownerId])
  @@index([billingTier])
}

model Photo {
  id           String      @id @default(uuid())
  eventId      String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  url          String
  uploaderName String?
  caption      String?
  status       PhotoStatus @default(VISIBLE)
  uploadSource String      @default("mobile")
  width        Int?
  height       Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model AdminCredential {
  id           String   @id @default(uuid())
  key          String   @unique @default("primary")
  passwordSalt String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

model DeletionLog {
  id        String   @id @default(uuid())
  photoId   String
  eventSlug String
  deletedBy String
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventSlug])
}
