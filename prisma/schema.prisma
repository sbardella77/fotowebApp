generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PhotoStatus {
  VISIBLE
  HIDDEN
}

enum BlobUploadKind {
  ROOM_PHOTO
  PRIVATE_DELIVERY
  PHOTOGRAPHER_UPLOAD
}

// TASK-02 — EXIF Safe Delivery Foundation.
//
// READY means ONLY: a display derivative was generated by
// lib/server/display-derivative.js and confirmed written to the derivative
// store. It must never be inferred from a Photo row's mere existence.
//
// LEGACY_UNVERIFIED is the migration default for every Photo row that
// existed before this field did — explicitly distinct from READY, never
// silently promoted to it. It is also, deliberately, the schema-level
// DEFAULT, so any future insert path that forgets to set this field fails
// safe (unverified) rather than fails open (falsely ready). The two
// application insert paths (lib/server/blob-upload-completion.js,
// lib/server/prisma-gallery-repository.js#createPhoto) explicitly override
// this default to PENDING for genuinely new uploads.
enum MediaType {
  IMAGE
  VIDEO
}

// Lifecycle of a VIDEO Photo row, driven by Mux webhooks
// (lib/server/video-uploads.js). NULL for every IMAGE row.
enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum DisplayDerivativeStatus {
  LEGACY_UNVERIFIED
  PENDING
  READY
  FAILED
}

enum BlobUploadSessionStatus {
  PENDING
  TOKEN_ISSUED
  UPLOADED
  COMPLETED
  REJECTED
  CLEANUP_PENDING
  CLEANUP_FAILED
  EXPIRED_CLEANED
}

enum StripeWebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Owner {
  id                                 String                    @id @default(uuid())
  email                              String                    @unique
  passwordHash                       String?
  passwordSalt                       String?
  plan                               String                    @default("free")
  extraEventCredits                  Int                       @default(0)
  extraEventCheckoutSessionId        String?
  stripeCustomerId                   String?
  stripeSubscriptionId               String?
  stripeCheckoutSessionId            String?
  sessionVersion                     Int                       @default(0)
  passwordChangedAt                  DateTime?
  planUpdatedAt                      DateTime                  @default(now())
  subscriptionCanceledAt             DateTime?
  subscriptionCancelAtPeriodEnd      Boolean                   @default(false)
  subscriptionCurrentPeriodEnd       DateTime?
  subscriptionCancelScheduledAt      DateTime?
  subscriptionBillingInterval        String?
  subscriptionStatus                 String?
  paymentFailedAt                    DateTime?
  subscriptionGraceUntil             DateTime?
  lastInvoiceId                      String?
  lastInvoiceStatus                  String?
  lastPaymentError                   String?
  stripeBillingCursorSubscriptionId  String?
  lastStripeSubscriptionEventCreated BigInt?
  lastStripeInvoiceEventCreated      BigInt?
  emailNotificationsEnabled          Boolean                   @default(true)
  createdAt                          DateTime                  @default(now())
  updatedAt                          DateTime                  @updatedAt
  events                             Event[]
  extraFreeEventCheckouts            ExtraFreeEventCheckout[]
  passwordResetTokens                OwnerPasswordResetToken[]

  @@index([email])
}

model OwnerPasswordResetToken {
  id              String    @id @default(cuid())
  ownerId         String
  owner           Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  purpose         String    @default("password_reset")
  expiresAt       DateTime
  usedAt          DateTime?
  requestedIpHash String?
  createdAt       DateTime  @default(now())

  @@index([ownerId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Event {
  id                                String                   @id @default(uuid())
  slug                              String                   @unique
  name                              String
  ownerEmail                        String?
  ownerId                           String?
  owner                             Owner?                   @relation(fields: [ownerId], references: [id])
  managementTokenHash               String?
  coverPhotoId                      String?
  billingTier                       String?
  stripeCheckoutSessionId           String?
  billingPurchasedAt                DateTime?
  originalDownloadUnlocked          Boolean                  @default(false)
  originalDownloadCheckoutSessionId String?
  retentionUntil                    DateTime?
  vaultExtendedUntil                DateTime?
  retentionPolicy                   String?
  archiveLocked                     Boolean                  @default(false)
  gracePeriodUntil                  DateTime?
  expiredAt                         DateTime?
  coverUrl                          String?
  pendingDigestPhotoCount           Int                      @default(0)
  lastPhotoDigestSentAt             DateTime?
  photoThresholdNotifiedAt          DateTime?
  retentionReminderT30SentAt        DateTime?
  retentionReminderT7SentAt         DateTime?
  retentionReminderT0SentAt         DateTime?
  createdAt                         DateTime                 @default(now())
  updatedAt                         DateTime                 @updatedAt
  photos                            Photo[]
  privateAssets                     PrivateAsset[]
  galleryDownloadJobs               GalleryDownloadJob[]
  moments                           EventMoment[]
  blobUploadSessions                BlobUploadSession[]
  pageViews                         EventPageView[]
  photographerUploadLinks           PhotographerUploadLink[]

  @@index([createdAt])
  @@index([ownerId])
  @@index([billingTier])
}

model PhotographerUploadLink {
  id            String         @id @default(cuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokenHash     String         @unique
  label         String?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  privateAssets PrivateAsset[]

  @@index([eventId])
}

model EventMoment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photos    Photo[]

  @@unique([eventId, slug])
  @@index([eventId, sortOrder])
}

model Photo {
  id                      String                  @id @default(uuid())
  eventId                 String
  originalName            String
  storedName              String
  mimeType                String
  size                    Int
  url                     String
  uploaderName            String?
  caption                 String?
  status                  PhotoStatus             @default(VISIBLE)
  uploadSource            String                  @default("mobile")
  width                   Int?
  height                  Int?
  momentId                String?
  contributorId           String?
  // Server-derived only — never trust a client-supplied value. 'owner' when
  // the request carried a valid owner session matching this photo's event
  // owner at upload time, 'guest' otherwise. NULL on rows created before
  // this field existed: unknown, never treated as 'guest'. Analytics
  // attribution only — never used for authorization/entitlements.
  uploadActorType         String?
  // See DisplayDerivativeStatus above for the exact semantics. Schema
  // default is the conservative LEGACY_UNVERIFIED value — new-upload call
  // sites explicitly pass PENDING instead of relying on this default.
  displayDerivativeStatus DisplayDerivativeStatus @default(LEGACY_UNVERIFIED)
  // Denormalized PhotoLike count, kept in step with PhotoLike rows inside
  // the same transaction (lib/server/photo-likes.js). Display only.
  likeCount               Int                     @default(0)
  // Videos live in Mux, never in Blob: guests only ever receive Mux's
  // re-encoded renditions (metadata/GPS stripped), mirroring the EXIF-safe
  // display derivative contract for images. VIDEO rows keep
  // displayDerivativeStatus PENDING forever so every image-derivative
  // consumer (resolveGuestPhotoUrl, covers, social images) skips them.
  mediaType               MediaType               @default(IMAGE)
  videoStatus             VideoStatus?
  muxUploadId             String?                 @unique
  muxAssetId              String?                 @unique
  muxPlaybackId           String?
  durationSec             Float?
  likes                   PhotoLike[]
  moment                  EventMoment?            @relation(fields: [momentId], references: [id], onDelete: SetNull)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  event                   Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([momentId, createdAt(sort: Desc)])
  @@index([displayDerivativeStatus])
}

// One heart per anonymous voter per photo. voterId is a server-issued
// httpOnly cookie UUID (lib/server/photo-likes.js) — best-effort uniqueness,
// never used for authorization, billing or gating.
model PhotoLike {
  id        String   @id @default(cuid())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  eventId   String
  voterId   String
  createdAt DateTime @default(now())

  @@unique([photoId, voterId])
  @@index([eventId, voterId])
}

model PrivateAsset {
  id                 String                  @id @default(uuid())
  eventId            String
  originalName       String
  storedName         String
  mimeType           String
  size               Int
  url                String
  uploadedByRole     String?                 @default("owner")
  photographerLinkId String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  event              Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photographerLink   PhotographerUploadLink? @relation(fields: [photographerLinkId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt(sort: Desc)])
  @@index([photographerLinkId])
}

model AdminCredential {
  id           String   @id @default(uuid())
  key          String   @unique @default("primary")
  passwordSalt String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

model DeletionLog {
  id        String   @id @default(uuid())
  photoId   String
  eventSlug String
  deletedBy String
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventSlug])
}

model GalleryDownloadJob {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status        String    @default("PENDING")
  resultUrl     String?
  error         String?
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  processedAt   DateTime?

  @@index([eventId, status])
  @@index([createdAt])
  @@index([status, processedAt])
  @@index([status, updatedAt])
}

model ExtraFreeEventCheckout {
  id                      String    @id @default(cuid())
  ownerId                 String
  owner                   Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stripeCheckoutSessionId String?   @unique
  eventName               String?
  status                  String    @default("pending")
  createdEventId          String?
  createdEventSlug        String?
  errorMessage            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  completedAt             DateTime?
  autoCreatedAt           DateTime?

  @@index([ownerId, status])
  @@index([stripeCheckoutSessionId])
}

model UpsellEvent {
  id         String   @id @default(uuid())
  eventName  String
  upsellType String?
  source     String?
  location   String?
  ctaPlan    String?
  ownerId    String?
  eventId    String?
  eventSlug  String?
  createdAt  DateTime @default(now())

  @@index([eventName, upsellType])
  @@index([source])
  @@index([createdAt])
  @@index([eventId])
}

model EventPageView {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

model BlobUploadSession {
  id String @id @default(cuid())

  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventSlug String

  uploadKind BlobUploadKind
  status     BlobUploadSessionStatus @default(PENDING)

  expectedPathname String @unique
  originalName     String
  mimeType         String
  expectedSize     Int

  uploaderName    String?
  caption         String?
  momentId        String?
  contributorId   String?
  // Server-bound at init time, for ROOM_PHOTO sessions only — never for
  // PRIVATE_DELIVERY/PHOTOGRAPHER_UPLOAD (those use PrivateAsset.uploadedByRole
  // instead). Carried through to Photo.uploadActorType at completion; never
  // read from the completion request payload. See lib/server/gallery-upload-actor.js.
  uploadActorType String?

  blobUrl  String?
  resultId String?

  tokenIssuedAt DateTime?
  uploadedAt    DateTime?
  consumedAt    DateTime?
  expiresAt     DateTime

  cleanupAttempts Int     @default(0)
  lastError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([eventSlug])
  @@index([status, expiresAt])
  @@index([uploadKind, status])
}

model StripeWebhookEvent {
  id        String                   @id @default(cuid())
  eventId   String                   @unique
  eventType String
  status    StripeWebhookEventStatus @default(PENDING)

  attempts  Int     @default(0)
  lastError String?

  receivedAt          DateTime  @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?

  updatedAt DateTime @updatedAt

  @@index([status, processingStartedAt])
}
